{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/manual", "destination": "/pdf/manual.pdf", "permanent": false },
    { "source": "/manual.html", "destination": "/pdf/manual.pdf", "permanent": false }
  ]
}
